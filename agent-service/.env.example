# ── Database ─────────────────────────────────────────────────────────────────
# Same database the Express backend uses — both services share one dataset.
MONGODB_URI=mongodb://<user>:<password>@127.0.0.1:27017/ai_factory?authSource=admin

# ── Sessions ─────────────────────────────────────────────────────────────────
# Any long random string. Required — the service refuses to start without it,
# since a predictable signing key means forgeable sessions.
SESSION_SECRET=change-me

# Shared secret proving a forwarded identity came from the Express proxy.
# Must match Express's AGENT_SERVICE_TOKEN. Unset means forwarded identities
# are refused outright rather than trusted.
AGENT_SERVICE_TOKEN=change-me

FRONTEND_ORIGIN=http://localhost:5173

# ── Models ───────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── Git artefact store (optional) ────────────────────────────────────────────
# Local checkout of the governance monorepo. Unset disables Git integration;
# the pipeline still runs, artefacts just are not versioned in Git.
GOVERNANCE_REPO_PATH=

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Unset disables pull-request gates. github.com — note SoW 5.0 specifies
# GitHub Enterprise, so this is a recorded divergence to settle with the client.
GITHUB_REPO=owner/governance-repo

# A GitHub App is preferred over a token: it gets webhooks, per-repository
# permissions, and commits attributed to the app rather than to an individual's
# credentials — which is what keeps the audit trail intact when someone leaves.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# Development fallback if no App is set up.
GITHUB_TOKEN=

# Required for webhooks. Without it every webhook is rejected — a payload
# decides whether an approval gate opens, so unverified means unauthorised.
GITHUB_WEBHOOK_SECRET=
