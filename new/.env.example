# Deterministic local-only defaults. Replace every secret before shared use.
POSTGRES_PASSWORD=local-postgres
LITELLM_MASTER_KEY=sk-local-litellm
LITELLM_API_BASE=http://127.0.0.1:4000
LITELLM_MODEL=openai/local-model
EMBEDDING_MODEL=openai/local-embedding-model

# Adapter selectors keep deterministic local behavior unless enabled.
ORCHESTRATION_MODE=direct
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=governed-requirements
STORE_ADAPTER=sqlite
MODEL_ADAPTER=deterministic
POLICY_ADAPTER=local
PRIVACY_ADAPTER=local
PRECEDENT_ADAPTER=disabled
IDENTITY_ADAPTER=dev
REPOSITORY_ADAPTER=local
SIGNER_ADAPTER=hmac
TELEMETRY_ADAPTER=noop

DATABASE_URL=postgresql://postgres:local-postgres@127.0.0.1:5433/factory
OPA_URL=http://127.0.0.1:8181
PRESIDIO_ANALYZER_URL=http://127.0.0.1:5002
PRESIDIO_ANONYMIZER_URL=http://127.0.0.1:5001
SIGNING_SECRET=dev-signing-key
WEBHOOK_SECRET=dev-webhook-secret

# Cookie/password login for ../frontend. Production uses Bearer/OIDC.
PHASE1_DEV_MODE=1

# OIDC: OIDC_ISSUER, OIDC_AUDIENCE, OIDC_JWKS_URL
# GitHub: REPOSITORY_ADAPTER=github, GITHUB_OWNER, GITHUB_REPO, GITHUB_TOKEN
# (or GITHUB_APP_ID + GITHUB_INSTALLATION_ID + GITHUB_APP_PRIVATE_KEY)
# Cosign: COSIGN_KEY, or COSIGN_CERTIFICATE_IDENTITY and COSIGN_CERTIFICATE_OIDC_ISSUER
# Phase 4 sandbox: E2B_API_KEY (local allow-list is used when unset)
# OpenHands: OPENHANDS_URL  SWE-agent: SWE_AGENT
# Phase 5 cluster: ARGO_SERVER / kube credentials (UAT URL is recorded without them)
# Backstage: docker compose --profile backstage up  (catalog YAML on :7007)
# Free substitutes vs tenant keys: docs/free-substitutes-and-tenant-keys.md
# OpenTofu/Argo apply against a real cluster is out of band of this Compose stack

LANGFUSE_NEXTAUTH_SECRET=local-nextauth-secret-change-me
LANGFUSE_SALT=local-salt-change-me
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_CLICKHOUSE_PASSWORD=local-clickhouse
LANGFUSE_REDIS_PASSWORD=local-redis
LANGFUSE_MINIO_USER=local-minio
LANGFUSE_MINIO_PASSWORD=local-minio-password
