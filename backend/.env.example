# Copy to .env and fill in real values. .env itself is gitignored.

# MongoDB connection string. If unset, the server falls back to a throwaway
# in-memory database (fine for quick demos, but data resets on every restart).
MONGODB_URI=mongodb://<user>:<password>@127.0.0.1:27017/ai_factory?authSource=admin

# Express session signing secret — any long random string.
SESSION_SECRET=change-me

PORT=4000

# Origin the frontend dev server runs on — allowed via CORS for session cookies to work
FRONTEND_ORIGIN=http://localhost:5173

# OpenRouter API key for the guided requirement-intake chatbot, report/FSD
# writing, and self-test code review (Claude Haiku 4.5 / GPT-4o-mini / DeepSeek).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API key, called directly (not via OpenRouter) for code generation
# and its tied fixers (security auto-fix, CI build fix, project demo synthesis).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
